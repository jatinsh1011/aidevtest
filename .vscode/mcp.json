{
  "inputs": [
    {
      "type": "promptString",
      "id": "github-github_personal_access_token",
      "description": "GitHub PAT with repo scope",
      "password": true
    }
  ],
  "servers": {
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github-github_personal_access_token}"
      }
    }
  }
}
